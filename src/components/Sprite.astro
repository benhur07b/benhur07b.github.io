---
import liteSvg from '../assets/terrain/mayon-lite.svg?raw';

// The sheet's symbols, drawn once per page and referenced with <use>: one map symbol per section (#s-<id>), the
// theme glyphs (#t-<theme>), and, on pages that print the relief small (locators, Learn sheets), the light relief
interface Props {
	lite?: boolean;
}
const { lite = false } = Astro.props;
const liteInner = liteSvg.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
	<defs>
		<symbol id="s-learn" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" fill="currentColor"></circle></symbol>
		<symbol id="s-services" viewBox="0 0 16 16"><rect x="1.5" y="1.5" width="13" height="13" fill="currentColor"></rect></symbol>
		<symbol id="s-work" viewBox="0 0 16 16"><path d="M8 1.2 15.2 14.6H.8Z" fill="currentColor"></path></symbol>
		<symbol id="s-writing" viewBox="0 0 16 16"><path d="M8 .8 15.2 8 8 15.2.8 8Z" fill="currentColor"></path></symbol>
		<symbol id="s-about" viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.8" fill="none" stroke="currentColor" stroke-width="2.4"></circle></symbol>
		{/* Theme glyphs: contours for geospatial and data, a network for AI, an open (dashed) boundary for open tech */}
		<symbol id="t-geo" viewBox="0 0 16 16"><path d="M1 12.5C4.5 8 8.5 14.5 15 9.5M1 6.5C4.5 2 8.5 8.5 15 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></symbol>
		<symbol id="t-ai" viewBox="0 0 16 16"><path d="M3 3 8 8 13 3M3 13 8 8 13 13" fill="none" stroke="currentColor" stroke-width="1.4"></path><g fill="currentColor"><circle cx="3" cy="3" r="2"></circle><circle cx="13" cy="3" r="2"></circle><circle cx="3" cy="13" r="2"></circle><circle cx="13" cy="13" r="2"></circle><circle cx="8" cy="8" r="2.5"></circle></g></symbol>
		<symbol id="t-open" viewBox="0 0 16 16"><rect x="2" y="2" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-dasharray="3.4 2.6"></rect></symbol>
		{lite && <g id="relief-lite" stroke="currentColor" set:html={liteInner} />}
	</defs>
</svg>

<style is:global>
	/* A <use> clone is styled by the rules that match its original, here in the sprite, so each place that draws the
	   light relief sets its weights through these inherited properties. Weights are screen pixels at any zoom. */
	#relief-lite path { vector-effect: non-scaling-stroke; stroke-width: var(--rl-int-w, 1px); stroke-opacity: var(--rl-int-o, 1); }
	#relief-lite path.idx { stroke-width: var(--rl-idx-w, 1.6px); stroke-opacity: var(--rl-idx-o, 1); }
	#relief-lite path.coast { stroke-width: var(--rl-coast-w, 1.4px); stroke-opacity: var(--rl-coast-o, 1); }
</style>
