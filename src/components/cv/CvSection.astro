---
import { inline, paras, type CvSection } from '../../data/cv';
import Entries from './CvEntries.astro';
import Rows from './CvRows.astro';

// A CV section's content, inside its inset, in the order the PDF prints it: its intro, its figures and the strip of
// tags under them, its own entries or rows, then its subsections. A subsection is a row of the ledger: its heading,
// dates and intro in the margin (kept in view while its entries scroll past), its entries or rows beside them. What
// prints is decided by the data's shape, never by the section's code, so a new section in the CV needs nothing here.
interface Props {
	section: CvSection;
}
const { section: s } = Astro.props;
const label = (l: string | string[]) => paras(l).map(inline).join('<br>');
---

{
	s.intro && (
		<div class="cv-intro">
			{paras(s.intro).map((t) => (
				<p set:html={inline(t)} />
			))}
		</div>
	)
}
{
	s.stats && (
		<ul class="cv-stats">
			{s.stats.map((st) => (
				<li>
					<b set:html={inline(st.value)} />
					<span set:html={label(st.label)} />
				</li>
			))}
		</ul>
	)
}
{
	s.tools && (
		<p class="cv-tools">
			{s.tools.label && <span class="kicker">{s.tools.label}</span>}
			{s.tools.items.map((t) => (
				<span class="tag">{t}</span>
			))}
		</p>
	)
}
{s.entries && <Entries entries={s.entries} columns={s.columns} level={3} />}
{s.rows && <Rows rows={s.rows} />}
{
	s.subsections?.map((sub) => (
		<div class:list={['cv-sub', { 'no-head': !sub.title }]}>
			{sub.title && (
				<div class="cv-sub-head">
					<h3 set:html={inline(sub.title)} />
					{sub.when && <p class="cv-when" set:html={inline(sub.when)} />}
					{sub.intro && paras(sub.intro).map((t) => <p class="cv-sub-intro" set:html={inline(t)} />)}
				</div>
			)}
			<div class="cv-sub-body">
				{!sub.title && sub.intro && paras(sub.intro).map((t) => <p class="cv-sub-intro" set:html={inline(t)} />)}
				{sub.entries && <Entries entries={sub.entries} columns={sub.columns} level={sub.title ? 4 : 3} />}
				{sub.rows && <Rows rows={sub.rows} />}
			</div>
		</div>
	))
}

<style is:global>
	/* The intro: its first paragraph is the section's lede, the rest read as body text */
	.cv-intro { max-width: 64ch; }
	.cv-intro p:first-child { font: 600 clamp(21px, 2vw, 26px)/1.32 var(--display); letter-spacing: -0.02em; }
	.cv-intro p + p { margin-top: 16px; color: var(--muted); font-size: 18px; }
	.cv-intro strong { font-weight: inherit; color: var(--ink); }

	/* The figures, as a row of spot heights */
	.cv-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); margin-top: clamp(32px, 4vw, 48px); border-top: 2px solid var(--ink); }
	.cv-stats li { padding: 22px 20px 4px; border-left: 1px solid var(--rule); }
	.cv-stats li:first-child { border-left: 0; padding-left: 0; }
	.cv-stats b { display: block; font: 800 clamp(44px, 5vw, 68px)/1 var(--display); letter-spacing: -0.045em; }
	.cv-stats span { display: block; margin-top: 10px; color: var(--muted); font-size: 16px; line-height: 1.4; }
	.cv-stats strong { color: var(--ink); font-weight: 700; }
	.cv-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 28px; }
	.cv-tools .kicker { margin-right: 8px; font-size: 12px; }
	.cv-tools .tag { padding: 6px 10px; border: 1px solid var(--rule); border-radius: 3px; font: 500 12px/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }

	/* A subsection: a row of the ledger */
	.cv-sub { display: grid; grid-template-columns: minmax(200px, 300px) 1fr; gap: 20px clamp(28px, 4vw, 56px); padding: 28px 0 8px; border-top: 2px solid var(--ink); }
	.cv-sub + .cv-sub, .cv-intro + .cv-sub, .cv-tools + .cv-sub, .cv-stats + .cv-sub { margin-top: clamp(28px, 3vw, 40px); }
	.cv-sub.no-head { grid-template-columns: 1fr; }
	.cv-sub-head { position: sticky; top: calc(var(--masthead) + 24px); align-self: start; }
	.cv-sub-head h3 { font-size: clamp(24px, 2.2vw, 30px); letter-spacing: -0.03em; line-height: 1.05; }
	.cv-sub-head .cv-when { margin-top: 10px; }
	.cv-sub-intro { margin-top: 14px; color: var(--muted); font-size: 16px; line-height: 1.5; }
	.cv-sub-body .cv-sub-intro { margin: 0 0 18px; max-width: 72ch; }
	.cv-sub-intro strong { color: var(--ink); font-weight: 600; }

	/* Entries */
	.cv-entries > .cv-entry { padding: 22px 0; border-bottom: 1px solid var(--rule); }
	.cv-entries > .cv-entry:first-child { padding-top: 0; }
	.cv-entries > .cv-entry:last-child { border-bottom: 0; }
	.cv-entries.cols-2 { display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(24px, 3vw, 40px); }
	.cv-entries.cols-2 > .cv-entry:nth-child(-n + 2) { padding-top: 0; }
	.cv-entries.cols-2 > .cv-entry:nth-last-child(-n + 2):nth-child(odd), .cv-entries.cols-2 > .cv-entry:last-child { border-bottom: 0; }
	.cv-head { display: grid; grid-template-columns: 1fr auto; gap: 4px 24px; align-items: start; max-width: 880px; }
	.cv-title { grid-column: 1; margin: 0; font: 700 clamp(20px, 1.7vw, 23px)/1.22 var(--display); letter-spacing: -0.02em; }
	.cv-title a { text-decoration: none; }
	.cv-title a:hover { text-decoration: underline; text-decoration-color: var(--block); }
	.cv-org { grid-column: 1; color: var(--muted); font-size: 16px; }
	.cv-head .cv-when { grid-column: 2; grid-row: 1; text-align: right; padding-top: 0.5em; }
	.cv-when { font: 500 12px/1.45 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
	.cv-when.now::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: var(--block); vertical-align: 1px; }
	.cv-note { margin-top: 8px; font: 500 12px/1.45 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
	.cv-text, .cv-bullets { max-width: 72ch; color: var(--muted); }
	.cv-text p, .cv-bullets > li { margin-top: 10px; }
	.cv-text strong, .cv-bullets strong { color: var(--ink); font-weight: 600; }
	.cv-text a, .cv-bullets a, .cv-sub-intro a, .cv-rows a, .cv-intro a { color: var(--ink); }
	.cv-bullets > li { position: relative; padding-left: 18px; }
	.cv-bullets > li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 6px; height: 6px; background: var(--block); }
	.cv-bullets .cv-bullets > li::before { background: transparent; border: 1px solid var(--block); }
	.cv-tags { margin-top: 12px; font: 500 12px/1.5 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }

	/* A body of work: its parts, or its others rolled up under the newest, hung from a rule like a leader line */
	.cv-parts, .cv-others { margin-top: 18px; padding-left: 20px; border-left: 2px solid var(--rule); max-width: 880px; }
	.cv-parts { display: grid; gap: 20px; }
	.cv-part .cv-title { font-size: 18px; }
	.cv-of { margin-bottom: 6px; font: 600 15px/1.4 var(--display); }
	.cv-of .kicker { font-size: 11px; margin-right: 4px; }
	.cv-others li { display: grid; grid-template-columns: 1fr auto; gap: 4px 24px; align-items: start; padding: 7px 0; border-top: 1px solid var(--hair); font: 600 16px/1.35 var(--display); letter-spacing: -0.01em; }
	.cv-others li .cv-when { text-align: right; padding-top: 0.2em; }
	.cv-more { margin-top: 6px; font: 500 12px/1.4 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }

	/* Rows: a label and its line, as a marginal key */
	.cv-rows { display: grid; grid-template-columns: minmax(110px, 170px) 1fr; }
	.cv-rows dt, .cv-rows dd { margin: 0; padding: 14px 0; border-top: 1px solid var(--rule); }
	.cv-rows dt:first-of-type, .cv-rows dd:first-of-type { border-top: 0; padding-top: 0; }
	.cv-rows dt { padding-right: 28px; font: 600 12px/1.6 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
	.cv-rows dd { color: var(--muted); }

	@media (max-width: 900px) {
		.cv-sub { grid-template-columns: 1fr; padding-top: 22px; }
		.cv-sub-head { position: static; }
		.cv-entries.cols-2 { grid-template-columns: 1fr; }
		.cv-entries.cols-2 > .cv-entry:nth-child(2) { padding-top: 22px; }
		.cv-entries.cols-2 > .cv-entry:nth-last-child(-n + 2):nth-child(odd):not(:last-child) { border-bottom: 1px solid var(--rule); }
		.cv-stats li:nth-child(odd) { border-left: 0; padding-left: 0; }
		.cv-rows { grid-template-columns: 1fr; }
		.cv-rows dd { border-top: 0; padding-top: 2px; }
		.cv-rows dt:not(:first-of-type) { padding-top: 14px; }
	}
	@media (max-width: 560px) {
		.cv-head, .cv-others li { grid-template-columns: 1fr; }
		.cv-head .cv-when { grid-column: 1; grid-row: auto; text-align: left; padding-top: 2px; }
		.cv-others li .cv-when { text-align: left; padding-top: 0; }
		.cv-stats { grid-template-columns: 1fr 1fr; }
		.cv-stats li { padding: 18px 0 4px 16px; }
		.cv-stats b { font-size: 40px; }
		.cv-stats span { font-size: 15px; }
	}
</style>
