---
import { pages, sections, sheetOf, type PageId } from '../data/site';
import { terrain } from '../data/terrain';

// A page's title, printed as a smaller sheet: a view of the survey in a neatline, with the spot height and the title
// block over it. The relief is the light one from the sprite, so the layout using this sets `lite`. The block's top
// row names the sheet and, on the right, `note` (a date, a revision); anything in the slot goes under the lede.
interface Props {
	page: PageId;
	title: string;
	lede: string;
	note?: string;
}
const { page, title, lede, note } = Astro.props;
const section = sections.find((s) => s.page === page);
const { subject } = terrain;
// The view is twice as wide as tall and centred on the summit's row, so the summit sits at (at, ½) of it; the frame
// is wider than 2:1 at every size, so the view's width always fills it and the mark lands where the summit is drawn
const { width, at } = pages[page].view;
const viewBox = [subject.x - at * width, subject.y - width / 4, width, width / 2].join(' ');
---

<header class="page-head" data-sheet-start>
	<div class="ph-sheet">
		<div class="ph-frame">
			<div class="ph-map" aria-hidden="true">
				<svg viewBox={viewBox} preserveAspectRatio="xMidYMid slice" fill="none">
					<use href="#relief-lite"></use>
				</svg>
				<span class="ph-peak" style={`left: ${at * 100}%`}>
					<svg viewBox="0 0 14 13"><path d="M7 1 13 12H1Z"></path></svg>
					<span><b>{subject.name}</b><i>{subject.height.toLocaleString('en')} m</i></span>
				</span>
			</div>
			<div class="ph-block">
				<div class="tb-row mono">
					<span>
						{
							section && (
								<svg class="sym" aria-hidden="true">
									<use href={`#s-${section.id}`} />
								</svg>
							)
						}
						Sheet {sheetOf(page)}{section && ` · ${section.label}`}
					</span>
					{note && <span>{note}</span>}
				</div>
				<h1>{title}</h1>
				<p class="lede">{lede}</p>
				<slot />
			</div>
		</div>
	</div>
</header>

<style is:global>
	.page-head { padding: 20px var(--gutter) 0; }
	.ph-sheet { max-width: var(--max); margin: 0 auto; border: 1px solid var(--rule); padding: 30px; }
	.ph-frame { position: relative; border: 2px solid var(--ink); min-height: 380px; display: flex; align-items: flex-end; overflow: hidden; }
	.ph-map { position: absolute; inset: 0; }
	.ph-map > svg { width: 100%; height: 100%; color: var(--ink); --rl-int-o: 0.3; --rl-idx-o: 0.65; --rl-coast-o: 0.75; }
	.ph-peak { position: absolute; top: 50%; display: flex; align-items: center; gap: 8px; transform: translate(-7px, -50%); font-family: var(--mono); }
	.ph-peak svg { width: 14px; height: 13px; fill: var(--block); stroke: var(--bg); stroke-width: 1.5; }
	.ph-peak > span { background: color-mix(in srgb, var(--bg) 78%, transparent); padding: 3px 6px; border-radius: 3px; }
	.ph-peak b { display: block; font: 800 14px/1.1 var(--display); letter-spacing: 0.02em; text-transform: uppercase; }
	.ph-peak i { font-style: normal; font-size: 11px; color: var(--muted); }
	.ph-block { position: relative; margin: 24px; width: min(720px, 100%); background: var(--bg); border: 2px solid var(--ink); padding: 24px 30px 28px; }
	.ph-block .tb-row { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 14px; margin-bottom: 20px; border-bottom: 1px solid var(--rule); font-size: 12px; }
	.ph-block .tb-row span:first-child { display: inline-flex; align-items: center; gap: 9px; }
	.ph-block .tb-row .sym { width: 12px; height: 12px; }
	.ph-block .tb-row span:last-child:not(:first-child) { color: var(--muted); }
	.ph-block h1 { font-size: clamp(44px, 5vw, 72px); line-height: 0.98; letter-spacing: -0.045em; }
	.ph-block .lede { margin-top: 18px; font-size: 18px; line-height: 1.5; max-width: 52ch; color: var(--muted); }
	@media (max-width: 900px) {
		.page-head { padding-top: 12px; }
		.ph-sheet { padding: 16px; }
		.ph-frame { flex-direction: column; align-items: stretch; min-height: 0; padding-top: 140px; }
		.ph-map { bottom: auto; height: 140px; border-bottom: 2px solid var(--ink); }
		.ph-block { margin: 0; width: auto; border: 0; padding: 20px 18px 24px; }
		.ph-block .lede { font-size: 17px; }
	}
</style>
