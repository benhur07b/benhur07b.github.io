---
import { insets } from '../data/site';

// The home page's fixed locator: the persistent navigation once the map face has scrolled away, marking the inset in
// view. Only where the gutter can hold it without covering an inset.
const entries = Object.entries(insets);
---

<nav class="sheet-index" aria-label="Sheet index">
	<p aria-hidden="true">Index</p>
	<ol>
		{
			entries.map(([id, { ref, title }]) => (
				<li>
					<a href={`#${id}`} data-for={id} aria-label={`${ref}, ${title}`} title={`${ref} · ${title}`}>
						{ref}
					</a>
				</li>
			))
		}
	</ol>
</nav>

<script>
	const index = document.querySelector<HTMLElement>('.sheet-index')!;
	const links = new Map([...index.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [a.dataset.for!, a]));
	// Shown between the map face and the imprint: the footer carries its own links, and the locator would cover its
	// bottom line
	let heroShown = true;
	let footerShown = false;
	const show = () => index.classList.toggle('on', !heroShown && !footerShown);
	new IntersectionObserver(([e]) => ((heroShown = e.intersectionRatio >= 0.12), show()), { threshold: [0, 0.12] }).observe(document.querySelector('.hero')!);
	new IntersectionObserver(([e]) => ((footerShown = e.intersectionRatio > 0), show()), { threshold: [0, 0.01] }).observe(document.querySelector('.colophon')!);
	const spy = new IntersectionObserver(
		(es) => {
			for (const e of es) {
				if (!e.isIntersecting) continue;
				links.forEach((a) => a.removeAttribute('aria-current'));
				links.get(e.target.id)?.setAttribute('aria-current', 'true');
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);
	document.querySelectorAll('.inset[data-ref]').forEach((s) => spy.observe(s));
</script>

<style is:global>
	.sheet-index {
		position: fixed; right: 16px; bottom: 16px; z-index: 30;
		background: var(--bg); border: 1px solid var(--ink); padding: 8px;
		opacity: 0; transform: translateY(8px); pointer-events: none;
		transition: opacity 240ms, transform 240ms;
	}
	.sheet-index.on { opacity: 1; transform: none; pointer-events: auto; }
	.sheet-index p { font: 600 9px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
	.sheet-index ol { display: grid; grid-template-columns: repeat(3, 22px); border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
	.sheet-index a { display: grid; place-items: center; height: 22px; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); font: 600 9px/1 var(--mono); text-decoration: none; color: var(--muted); }
	.sheet-index a:hover { color: var(--ink); background: var(--hair); }
	.sheet-index a[aria-current='true'] { background: var(--block); color: var(--mark); }
	@media (max-width: 1279px) {
		.sheet-index { display: none; }
	}
</style>
