---
// Who's behind BNHR, in the first person. The designs never show the full name, only "I'm Ben"
interface Props {
	// On the home page the inset stands in for the About page: it introduces me by name and links on. On the About
	// page the heading ("Hi, I'm Ben") does the introducing, so the paragraph starts at what I do.
	teaser?: boolean;
}
const { teaser = false } = Astro.props;
---

<p class="about-text">{teaser ? "I'm Ben: a technologist" : 'A technologist'}, educator, and free software advocate who helps people solve problems with open technologies—from building technical solutions to growing communities of practice—because I believe you should own the technology you depend on.</p>
<p class="about-text">BNHR has been a QGIS sustaining member since 2020, helping fund the software I teach. I also co-founded SmartCT, a tech non-profit, and the Civic Literacy Initiative.</p>
<div class="compiler mono">
	<span>Compiled by BNHR</span>
	{
		teaser && (
			<a class="arrow-link" href="/about/">
				About me <span aria-hidden="true">→</span>
			</a>
		)
	}
</div>

<style is:global>
	.about-text { font: 600 clamp(22px, 2.2vw, 28px)/1.3 var(--display); letter-spacing: -0.02em; }
	.about-text + .about-text { margin-top: 18px; font: 400 17px/1.55 var(--text); letter-spacing: 0; color: var(--muted); }
	.compiler { margin-top: 26px; padding-top: 16px; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; font-size: 12px; color: var(--muted); }
</style>
