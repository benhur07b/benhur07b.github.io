---
import { archive } from '../data/site';

// Until posts are published here, the gazetteer points to the archived site's blog
---

<div class="linkout">
	<p><strong>New writing is on its way.</strong> Posts from 2017 to 2022 stay readable on the archived site.</p>
	<div class="ctas"><a class="btn" href={`${archive.href}blog/`}>Read the archive <span aria-hidden="true">↗</span></a></div>
</div>
