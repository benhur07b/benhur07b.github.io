---
import Contact from '../components/Contact.astro';
import Inset from '../components/Inset.astro';
import PageHead from '../components/PageHead.astro';
import ServiceClasses from '../components/ServiceClasses.astro';
import TrainingNote from '../components/TrainingNote.astro';
import Sheet from '../layouts/Sheet.astro';
---

<Sheet title="Services" description="Training, consulting, custom builds, and data and AI literacy workshops in open geospatial, data and AI tools." current="services" lite>
	<PageHead section="services" title="Services" lede="Training, consulting and custom builds in open geospatial, data and AI tools, all on software you can keep using after I've gone." />
	<div class="insets">
		<Inset id="classes" ref="A1" kicker="Feature classes" title="What I do" aside="The first 30 minutes of a consult are free.">
			<ServiceClasses />
		</Inset>
		<Inset id="training" ref="A2" kicker="Survey schedule" title="Public training" aside="Booked on Learn QGIS, so the dates are never out of date here.">
			<TrainingNote />
		</Inset>
		<Contact ref="A3" />
	</div>
</Sheet>
