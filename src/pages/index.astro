---
import AboutText from '../components/AboutText.astro';
import Clients from '../components/Clients.astro';
import Contact from '../components/Contact.astro';
import HeroMap from '../components/HeroMap.astro';
import Inset from '../components/Inset.astro';
import LearnSheets from '../components/LearnSheets.astro';
import MapsNote from '../components/MapsNote.astro';
import Projects from '../components/Projects.astro';
import ServiceClasses from '../components/ServiceClasses.astro';
import SheetIndex from '../components/SheetIndex.astro';
import TrainingNote from '../components/TrainingNote.astro';
import WritingNote from '../components/WritingNote.astro';
import { insets } from '../data/site';
import Sheet from '../layouts/Sheet.astro';

const inset = <K extends keyof typeof insets>(id: K) => ({ id, ...insets[id] });
---

<Sheet lite description="BNHR: training, consulting and custom builds in open geospatial, data and AI tools: QGIS, PostGIS, GeoServer, Python and machine learning.">
	<HeroMap />
	<div class="insets">
		<Inset {...inset('services')} kicker="Feature classes" aside="Maps, data and AI, all on open software you can keep using after I've gone.">
			<ServiceClasses />
		</Inset>

		<Inset {...inset('learn')} kicker="Adjoining sheets" aside="Free courses and workbooks, each on its own site. Learn at your own pace, or join an instructor-led training.">
			<LearnSheets />
		</Inset>

		<Inset {...inset('training')} kicker="Survey schedule" aside="Booked on Learn QGIS, so the dates are never out of date here.">
			<TrainingNote />
		</Inset>

		<Inset {...inset('work')} kicker="Surveyed sites" aside="Platforms, data tools and guides for government, civil society and the public.">
			<Projects />
		</Inset>

		<Inset {...inset('maps')} kicker="Map drawer" aside="Maps from the analysis in my writing and from the #30DayMapChallenge.">
			<MapsNote />
		</Inset>

		<Inset {...inset('writing')} kicker="Gazetteer" aside="Geospatial, data, AI and open tech.">
			<WritingNote />
		</Inset>

		<div class="pair">
			<Inset {...inset('clients')} kicker="Place names">
				<Clients />
			</Inset>
			<Inset {...inset('about')} kicker="Compiler">
				<AboutText />
			</Inset>
		</div>

		<Contact ref={insets.contact.ref} />
	</div>
	<SheetIndex slot="after-main" />
</Sheet>
