---
import Clients from '../components/Clients.astro';
import Contact from '../components/Contact.astro';
import Inset from '../components/Inset.astro';
import MapsNote from '../components/MapsNote.astro';
import PageHead from '../components/PageHead.astro';
import Projects from '../components/Projects.astro';
import { socials } from '../data/site';
import Sheet from '../layouts/Sheet.astro';

const github = socials.find((s) => s.name === 'GitHub')!;
---

<Sheet title="Work" description="Selected work by BNHR: platforms, data tools and guides for government, civil society and the public, on open software." current="work" lite>
	<PageHead section="work" title="Work" lede="Platforms, data tools and guides for government, civil society and the public, built on open software." />
	<div class="insets">
		<Inset id="projects" ref="A1" kicker="Surveyed sites" title="Selected work" aside="Each one is live; the titles open them.">
			<Projects />
		</Inset>
		<Inset id="maps" ref="A2" kicker="Map drawer" title="Maps" aside="Maps from the analysis in my writing and from the #30DayMapChallenge.">
			<MapsNote />
		</Inset>
		<Inset id="code" ref="A3" kicker="Open source" title="Code" aside="Open tools are the point, so the code is open too.">
			<div class="linkout">
				<p><strong>Code from projects and workshops is on GitHub.</strong></p>
				<div class="ctas"><a class="btn" href={github.href}>{github.name} · {github.handle} <span aria-hidden="true">↗</span></a></div>
			</div>
		</Inset>
		<Inset id="clients" ref="A4" kicker="Place names" title="Clients and partners">
			<Clients />
		</Inset>
		<Contact ref="A5" />
	</div>
</Sheet>
