---
import AboutText from '../components/AboutText.astro';
import Clients from '../components/Clients.astro';
import Contact from '../components/Contact.astro';
import Inset from '../components/Inset.astro';
import PageHead from '../components/PageHead.astro';
import Sheet from '../layouts/Sheet.astro';
---

<Sheet title="About" description="BNHR is training, consulting and custom builds in open geospatial, data and AI tools, run by Ben since the 2010s." current="about" lite>
	<PageHead section="about" title="About" lede="Training, consulting and custom builds in open geospatial, data and AI tools, from the Philippines." />
	<div class="insets">
		<div class="pair">
			<Inset id="compiler" ref="A1" kicker="Compiler" title="Hi, I'm Ben">
				<AboutText />
			</Inset>
			<Inset id="clients" ref="A2" kicker="Place names" title="Clients and partners">
				<Clients />
			</Inset>
		</div>
		<Contact ref="A3" />
	</div>
</Sheet>
